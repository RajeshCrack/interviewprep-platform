# Copy to deploy/.env on the API server and fill in. Never commit the real file.

# Public name of the API, for example api.yourdomain.in. Its DNS A record must point at this server.
API_DOMAIN=api.example.com

# The website address, exactly as students see it (no trailing slash). Netlify gives you one, or use your own domain.
CORS_ORIGINS=https://your-site.netlify.app

# Generate each with: openssl rand -base64 36
DB_PASSWORD=change-me
JWT_SECRET=change-me-must-be-at-least-32-characters-long

# Judge0 server (deploy/judge0). Use its private network address, and the same token you set there.
JUDGE_URL=http://10.0.0.3:2358
JUDGE_TOKEN=change-me

# Optional: real email for reminders. Leave SPRING_MAIL_HOST empty to only log emails.
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@yourdomain.in

APP_ZONE=Asia/Kolkata
