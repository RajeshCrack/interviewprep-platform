# Copy to deploy/judge0/.env on the Judge0 server. Never commit the real file.
# The server's private network address, so port 2358 is not on the public internet. For example 10.0.0.3
JUDGE0_BIND_IP=10.0.0.3
# The same token the API server uses as JUDGE_TOKEN.
JUDGE_TOKEN=change-me
# Generate each with: openssl rand -base64 36
REDIS_PASSWORD=change-me
JUDGE0_DB_PASSWORD=change-me
JUDGE0_SECRET_KEY_BASE=change-me
